{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "4",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70"
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(ls *)",
      "Bash(npm test)",
      "Read",
      "Edit(./**)",
      "Write(./**)",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf $HOME/*)",
      "Bash(sudo rm *)",
      "Bash(git push -f *)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push * +*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(curl * | bash *)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh *)",
      "Bash(curl * | sh)",
      "Bash(chmod -R 777 *)",
      "Bash(mkfs *)",
      "Bash(dd * of=/dev/*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",
      "Read(//**/*.pem)",
      "Read(//**/.env*)"
    ],
    "ask": [
      "Bash(gh repo delete *)",
      "Bash(rtk gh repo delete *)",
      "Bash(gh pr merge *)",
      "Bash(rtk gh pr merge *)",
      "mcp__*__send_message",
      "mcp__*__reply",
      "mcp__*__forward"
    ],
    "additionalDirectories": [
      "~/code"
    ]
  },
  "sandbox": {
    "enabled": true
  },
  "model": "opus",
  "outputStyle": "Concise",
  "autoMemoryDirectory": "~/notes/claude-memory",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notes-repo-pull.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/slop-check-hook.sh"
          }
        ]
      }
    ]
  }
}
