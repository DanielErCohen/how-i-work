# --- OS cruft ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# Finder duplicate artifacts: ".gitkeep 2", "note copy.md"
# Deliberately NOT using a broad "* 2.*" glob. It silently swallows legitimately
# named files like "Sprint 2.md" or "Chapter 2.md", and a note that never gets
# committed because of an ignore rule is the hardest kind of loss to notice.
# Sweep for the numbered variety instead, during the weekly review:
#   git ls-files | grep -E ' [0-9]+(\.|$)'
.gitkeep 2
*.gitkeep 2
*\ copy
*\ copy.*

# --- secrets: never commit these ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
credentials.json
.credentials.json
*.credentials.json
service-account*.json
*-secret*.yml
*-secret*.yaml
.claude.json

# --- caches and generated data ---
node_modules/
__pycache__/
*.pyc
.venv/
venv/
.cache/
*.log
.mcp_data/
.obsidian/workspace*
.obsidian/cache/

# --- large media: prefer a link over a commit ---
# Uncomment if the repo starts outgrowing git. Binaries never delta-compress,
# so every re-save of an image keeps the old copy in history forever.
# *.mp4
# *.mov
# *.zip
# *.pdf
